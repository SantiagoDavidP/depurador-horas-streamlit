# =============================================================================
# BONAPHARM API -- Environment Variables
# Copy this file to .env and fill in real values for production.
# All variables have safe defaults for local development.
# =============================================================================

# Application
ENVIRONMENT=development
DEBUG=True

# Frontend
VITE_API_URL=http://localhost:8000/api

# Database (async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bonapharm_pedidos

# Docker Compose PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bonapharm_pedidos

# CORS (comma-separated JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Auth / JWT
SECRET_KEY=change-this-to-a-secure-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Microsoft Entra ID (Azure AD)
ENTRA_ID_CLIENT_ID=
ENTRA_ID_SECRET_KEY=
ENTRA_ID_TENANT_ID=

# External APIs
DATAVERSE_ENVIRONMENT_URL=
SAP_API_BASE_URL=https://api.sap.bonapharm.com/v1
SAP_API_KEY=
SHAREPOINT_SITE_URL=

# SMTP (Email)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@bonapharm.com
SMTP_TLS=True

# Business rules
IGV_RATE=0.18
COMISION_DIMEXA_PCT=0.10
COMISION_QUIMICA_PCT=0.13
