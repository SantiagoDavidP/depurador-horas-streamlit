# ============================================================================
# ProyectoStaffAumentado - Environment Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# DATA SOURCE CONFIGURATION
# ----------------------------------------------------------------------------
# Select data source type: "excel" or "sql"
DATA_SOURCE_TYPE=excel

# ----------------------------------------------------------------------------
# MICROSOFT FABRIC SQL CONFIGURATION (Required when DATA_SOURCE_TYPE=sql)
# ----------------------------------------------------------------------------
# Server endpoint for Microsoft Fabric Data Warehouse
# Format: <workspace>.datawarehouse.fabric.microsoft.com
FABRIC_SQL_SERVER=your-workspace.datawarehouse.fabric.microsoft.com
FABRIC_SQL_DATABASE=YourDatabase
FABRIC_SQL_TABLE=Timesheets

# ----------------------------------------------------------------------------
# AUTHENTICATION METHOD (choose the best option for your scenario)
# ----------------------------------------------------------------------------
# Options: managed_identity | service_principal | azure_ad_user | sql_auth
FABRIC_SQL_AUTH_METHOD=managed_identity

# --- OPCIÓN 1: Managed Identity (RECOMENDADA para producción) ---
# ✅ Más segura - sin credenciales en código
# ✅ Automática cuando se ejecuta en Azure (App Service, VM, Functions, Container Apps)
# ✅ Otra persona solo necesita permisos en Fabric, no necesita tus credenciales
# No requiere variables adicionales

# --- OPCIÓN 2: Service Principal (recomendada para CI/CD y desarrollo compartido) ---
# ✅ Credenciales rotables e independientes de usuario
# ✅ Ideal para que otras personas usen el proyecto
# Cómo crear: Azure Portal → Azure Active Directory → App registrations → New registration
# FABRIC_SQL_AUTH_METHOD=service_principal
# AZURE_CLIENT_ID=your-app-client-id
# AZURE_CLIENT_SECRET=your-app-client-secret
# AZURE_TENANT_ID=your-tenant-id

# --- OPCIÓN 3: Azure AD User (solo para desarrollo local personal) ---
# ⚠️ Usa tus credenciales personales (requiere: az login)
# ⚠️ NO recomendado para compartir con otras personas
# FABRIC_SQL_AUTH_METHOD=azure_ad_user

# --- OPCIÓN 4: SQL Authentication (legacy, no recomendado) ---
# ⚠️ Menos seguro - credenciales en texto plano
# FABRIC_SQL_AUTH_METHOD=sql_auth
# FABRIC_SQL_USERNAME=your_username
# FABRIC_SQL_PASSWORD=your_password

# ----------------------------------------------------------------------------
# AZURE OPENAI
# ----------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ----------------------------------------------------------------------------
# AZURE STORAGE
# ----------------------------------------------------------------------------
# Azure Storage (usa connection string o URL + key/SAS)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=https://<tu-cuenta>.blob.core.windows.net/
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=timesheets

# ----------------------------------------------------------------------------
# AZURE AD AUTHENTICATION (Optional - para login con grupos de seguridad)
# ----------------------------------------------------------------------------
# Set to "true" to enable Azure AD authentication, "false" to disable
AZURE_AD_AUTH_ENABLED=false

# App Registration credentials (Azure Portal → Azure AD → App registrations)
AZURE_AD_CLIENT_ID=your-client-id-here
AZURE_AD_CLIENT_SECRET=your-client-secret-here
AZURE_AD_TENANT_ID=your-tenant-id-here

# Redirect URI (debe coincidir con la configuración en App Registration)
# Desarrollo local:
AZURE_AD_REDIRECT_URI=http://localhost:8501
# Producción (reemplazar con tu dominio):
# AZURE_AD_REDIRECT_URI=https://your-app-domain.com

# Optional: Restringir acceso solo a miembros de un grupo de seguridad específico
# Object ID del grupo (Azure Portal → Azure AD → Groups → [Tu Grupo])
# Dejar vacío para permitir todos los usuarios autenticados
AZURE_AD_ALLOWED_GROUP_ID=

# ----------------------------------------------------------------------------
# APPLICATION SETTINGS
# ----------------------------------------------------------------------------
# Logging
LOG_LEVEL=INFO